# Copy to .env.local for local dev, and add the same two values in Vercel > Project > Settings > Environment Variables.
# Supabase > Project Settings > API (or Connect). Use the anon / publishable key, never the service-role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
